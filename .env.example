# Copy this file to ".env" and fill in your own values.

# PostgreSQL connection (user:password@host:port/database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cousin_site

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# First admin account. It is created automatically on first start
# (only if no admin exists yet). Password must be 8+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Set to 1 when the site runs on https:// (recommended in production)
SECURE_COOKIES=0

# Set to 1 when running behind nginx / a hosting proxy
TRUST_PROXY=0

# Timezone used to display dates
TZ_NAME=Asia/Dhaka

# Docker compose only: password for the bundled database
DB_PASSWORD=postgres

# --- Optional -------------------------------------------------------------
# Biggest video / backup file you can upload, in MB (default 1024)
# MAX_UPLOAD_MB=1024
# Where uploads and backups are kept. On Railway these default to the volume.
# UPLOAD_DIR=/data/uploads
# BACKUP_DIR=/data/backups
# Automatic backups (1 = on) and automatic restore when the database is empty
# AUTO_BACKUP=1
# AUTO_RESTORE=1
# BACKUP_KEEP=60
